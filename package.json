{
  "name": "picking-price",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "npm run build && npm run start:local",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "start:local": "node scripts/local-postgres.mjs && node --env-file=.env --import tsx server/index.ts",
    "admin:create": "node --import tsx server/create-admin.ts",
    "lint": "eslint .",
    "test": "npm run test:password && npm run test:market && npm run test:http",
    "test:password": "node --test --import tsx tests/password.test.ts",
    "test:market": "node --import tsx tests/market-integration.ts",
    "test:http": "node --import tsx tests/express-http.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tsx": "^4.23.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
